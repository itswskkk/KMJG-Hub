# Copy to .env and fill in real values before running `docker compose up`.
# Never commit the resulting .env file (see docs/PRD.md "Open Source and
# Privacy" — deployment secrets must not enter the public repository).

POSTGRES_USER=kmjg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kmjg_hub

# Origins the Desktop Client connects from (Vite dev server + Tauri webview).
KMJG_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# Hours a new session stays valid before requiring re-authentication.
KMJG_SESSION_TTL_HOURS=720

# Host port the KMJG Hub Server is published on.
KMJG_PUBLISHED_PORT=8080
